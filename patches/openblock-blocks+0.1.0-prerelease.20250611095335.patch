+          "type": "field_input",
+          "name": "VAR",
+          "text": "myVar"
+        }
+      ],
+      "colour": "#FF8C1A",
+      "colourSecondary": "#DB6E00",
+      "colourTertiary": "#CF8B17",
+      "extensions": ["output_string"]
+    });
+  }
+};
+
+/**
+ * Block to set a typed variable value
+ */
+Blockly.Blocks['data_typedvariable_set'] = {
+  init: function() {
+    this.jsonInit({
+      "message0": "Set typed %1 to %2",
+      "args0": [
+        {
+          "type": "field_input",
+          "name": "VAR",
+          "text": "myVar"
+        },
+        {
+          "type": "input_value",
+          "name": "VALUE"
+        }
+      ],
+      "colour": "#FF8C1A",
+      "colourSecondary": "#DB6E00",
