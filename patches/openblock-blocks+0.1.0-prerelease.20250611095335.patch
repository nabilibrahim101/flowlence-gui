+      "colourTertiary": "#CF8B17",
+      "extensions": ["shape_statement"]
+    });
+  }
+};
+
+/**
+ * Block to get a typed variable value (reporter)
+ */
+Blockly.Blocks['data_typedvariable_get'] = {
+  init: function() {
+    this.jsonInit({
+      "message0": "typed var %1",
+      "args0": [
