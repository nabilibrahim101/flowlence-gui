index 4214561..35c64a5 100644
--- a/node_modules/openblock-blocks/generators/arduino/data.js
+++ b/node_modules/openblock-blocks/generators/arduino/data.js
@@ -170,3 +170,73 @@ Blockly.Arduino['data_showlist'] = function() {
 Blockly.Arduino['data_hidelist'] = function() {
   return '';
 };
+
+// ============================================================
+// Flowlence Typed Variable Generators
+// ============================================================
+
+/**
+ * Generator for declaring a typed variable
+ */
+Blockly.Arduino['data_typedvariable_declare'] = function(block) {
+  var type = block.getFieldValue('TYPE');
+  var varName = block.getFieldValue('VAR');
+  var value = Blockly.Arduino.valueToCode(block, 'VALUE',
+      Blockly.Arduino.ORDER_ASSIGNMENT) || (type === 'TEXT' ? '""' : '0');
+
+  // Clean variable name (remove spaces, special chars)
+  varName = varName.replace(/[^a-zA-Z0-9_]/g, '_');
+
+  // Determine Arduino type based on selection
+  var arduinoType = (type === 'TEXT') ? 'String' : 'float';
+
+  // For Text/String type, ensure the value is a valid String assignment
+  if (type === 'TEXT') {
+    // If value is a bare number (not already a string/expression), wrap in String()
+    if (/^\d+(\.\d+)?$/.test(value)) {
+      value = 'String(' + value + ')';
+    }
+  }
+
+  // For Number type, strip quotes if the value came from a text shadow block
+  if (type === 'NUMBER') {
+    var match = value.match(/^"(.*)"$/);
+    if (match) {
+      value = match[1] || '0';
+    }
+    // Ensure it's a valid number, fallback to 0
+    if (!/^[\d.\-]/.test(value) && value !== '0') {
+      value = '0';
+    }
+  }
+
+  // Add variable declaration to definitions
+  Blockly.Arduino.definitions_['typedvar_' + varName] = arduinoType + ' ' + varName + ';';
+
+  // Return initialization code (goes in setup or where block is placed)
+  return varName + ' = ' + value + ';\n';
+};
+
+/**
+ * Generator for getting a typed variable value
+ */
+Blockly.Arduino['data_typedvariable_get'] = function(block) {
+  var varName = block.getFieldValue('VAR');
+  // Clean variable name
+  varName = varName.replace(/[^a-zA-Z0-9_]/g, '_');
+  return [varName, Blockly.Arduino.ORDER_ATOMIC];
+};
+
+/**
+ * Generator for setting a typed variable value
+ */
+Blockly.Arduino['data_typedvariable_set'] = function(block) {
+  var varName = block.getFieldValue('VAR');
+  var value = Blockly.Arduino.valueToCode(block, 'VALUE',
+      Blockly.Arduino.ORDER_ASSIGNMENT) || '0';
+
+  // Clean variable name
+  varName = varName.replace(/[^a-zA-Z0-9_]/g, '_');
+
+  return varName + ' = ' + value + ';\n';
+};
